<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LocalAutomation.Avalonia.Controls"
             xmlns:conv="clr-namespace:LocalAutomation.Avalonia.Converters"
             x:Class="LocalAutomation.Avalonia.Controls.ExecutionMetricsStrip"
             x:DataType="controls:ExecutionMetricsStrip"
             x:Name="Root">
    <UserControl.Resources>
        <conv:DurationTextConverter x:Key="DurationTextConverter" />
    </UserControl.Resources>
    <!-- One shared metrics strip keeps duration, warning, and error badges visually identical everywhere they appear. -->
    <StackPanel Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
        <Border Classes="pill"
                Padding="8,4"
                VerticalAlignment="Center">
            <TextBlock Classes="muted metric-pill-text"
                       Text="{Binding Duration, RelativeSource={RelativeSource AncestorType=controls:ExecutionMetricsStrip}, Converter={StaticResource DurationTextConverter}, StringFormat='TIME {0}'}" />
        </Border>
        <!-- WARN and ERR keep the existing metric counts while button semantics make each badge a log filter affordance. -->
        <Button Classes="metric-filter-pill warning-accent"
                Classes.active="{Binding IsWarningFilterActive, RelativeSource={RelativeSource AncestorType=controls:ExecutionMetricsStrip}}"
                Click="WarningFilter_Click"
                VerticalAlignment="Center">
            <TextBlock Classes="muted metric-pill-text"
                       Classes.warning-accent="{Binding HasWarnings, RelativeSource={RelativeSource AncestorType=controls:ExecutionMetricsStrip}}"
                       Text="{Binding WarningCount, RelativeSource={RelativeSource AncestorType=controls:ExecutionMetricsStrip}, StringFormat='WARN {0}'}" />
        </Button>
        <Button Classes="metric-filter-pill error-accent"
                Classes.active="{Binding IsErrorFilterActive, RelativeSource={RelativeSource AncestorType=controls:ExecutionMetricsStrip}}"
                Click="ErrorFilter_Click"
                VerticalAlignment="Center">
            <TextBlock Classes="muted metric-pill-text"
                       Classes.error-accent="{Binding HasErrors, RelativeSource={RelativeSource AncestorType=controls:ExecutionMetricsStrip}}"
                       Text="{Binding ErrorCount, RelativeSource={RelativeSource AncestorType=controls:ExecutionMetricsStrip}, StringFormat='ERR {0}'}" />
        </Button>
    </StackPanel>
</UserControl>
